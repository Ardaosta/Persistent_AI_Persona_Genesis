{
  "_comment": "Genesis hooks for Claude Code, merged into the AI home's .claude/settings.json by `genesis init` / `genesis wire-claude`. SessionStart: harness-enforced boot ritual (genesis-boot-context prints the index + continuity + live wall-clock to stdout; Claude Code injects it before turn 1, so identity-load never depends on the model remembering to load itself). UserPromptSubmit: register re-anchor every 10 prompts. Stop: the craft gate, exit 2 + stderr once per session when no friction entry was recorded. VERIFY this schema against the installed Claude Code version before writing by hand; hook schemas evolve.",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [ { "type": "command", "command": "GENESIS_ROOT=\"${GENESIS_ROOT}\" \"${GENESIS_EXE}\" boot-context --hook" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "GENESIS_ROOT=\"${GENESIS_ROOT}\" \"${GENESIS_EXE}\" reanchor --hook" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "GENESIS_ROOT=\"${GENESIS_ROOT}\" \"${GENESIS_EXE}\" craft-gate --hook" } ] }
    ]
  }
}
